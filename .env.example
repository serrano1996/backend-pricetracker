# Scrapers (Render)
SCRAPER_MERCADONA_URL=xxx
SCRAPER_MERCADONA_API_KEY=xxx
SCRAPER_ALCAMPO_URL=xxx
SCRAPER_ALCAMPO_API_KEY=xxx
SCRAPER_DIA_URL=xxx
SCRAPER_DIA_API_KEY=xxx

# Local (docker-compose). Para producción irían los de Supabase y el Redis del backend.
DB_URL=xxx
DB_USER=xxx
DB_PASSWORD=xxx
REDIS_URL=xxx

CORS_ALLOWED_ORIGINS=xxx

# Max scraper calls per window, shared by all instances; past it, searches serve stored data
SCRAPER_CALL_BUDGET=300
# Window length (ISO-8601 duration)
SCRAPER_CALL_BUDGET_WINDOW=PT1H